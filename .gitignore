# Build trees. CMake is driven out-of-source; every configure lands in one of these.
build/
build-*/

# Fetched dependencies. deps/CMakeLists.txt is the declaration and is the only tracked file here.
# Everything else under deps/ is a checkout of another repository and belongs to that repository.
deps/*
!deps/CMakeLists.txt

# Coverage. gcov/lcov emit one pair per object plus the merged report SonarCloud reads.
*.gcno
*.gcda
*.gcov
coverage/
coverage.xml
coverage.info
sonar-coverage.xml
.scannerwork/
bw-output/

# Python. The tools in tools/dev_env are run directly and cache next to themselves.
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS.
.vscode/
docs/html/
docs/xml/
docs/doxygen-warnings.log
