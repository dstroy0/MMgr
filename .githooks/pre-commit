#
# Holds every technical document to ASD-STE100 before a commit is written: a document may carry no more findings
# than test/ste_ratchet.tsv allows it, and a new document none. Turn it on once per clone:
#
#     git config core.hooksPath .githooks
#
# To see the findings:         python test/harness.py ste --show [DOC ...]
# To lower the ratchet after a repair: python test/harness.py ste --lower

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
for python in python3 python; do
    if command -v "$python" >/dev/null 2>&1; then
        exec "$python" test/harness.py ste
    fi
done
echo "pre-commit: no python to run the ASD-STE100 check" >&2
exit 1
