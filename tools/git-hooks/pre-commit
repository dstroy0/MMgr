#!/usr/bin/env bash
# Refuses a commit whose work tree carries a banned word.
#
# Install once per clone:   git config core.hooksPath tools/git-hooks
#
# MMgr is a public repository, and without this file a commit here runs zero gates. The name guard
# is a tree-wide control and not a per-repository preference. A repository that ships nothing does
# not say that it needs nothing, it says nothing.
#
# WHERE THE CHECKER IS, AND WHY IT IS NOT IN THIS TREE
#
# The list of banned words is itself the thing to keep out. A denylist stored inside the tree
# would write every word it bans into the tree and defeat its own purpose. Both the list and the
# checker sit outside every repository they guard. This hook reads their directory from
# MMGR_COMMIT_GUARD and not a literal path. A hard-coded absolute path breaks a tree-wide rule
# and would be wrong on any other machine.
#
# IT FAILS CLOSED
#
# An absent checker refuses the commit. It does not skip the step and exit 0. A gate that cannot
# find its instrument reports the same success as a gate that ran and found nothing. The person
# who reads the exit code cannot tell the two apart. Set MMGR_HOOK_NO_BANNED_SCAN=1 to
# bypass deliberately, which is a decision that leaves a trace in the shell and not a silence.
set -uo pipefail

# Resolve the tree under commit and not this script's own location. A linked worktree runs
# the shared checkout's copy of this file. So a root taken from the script path reconciles the
# wrong tree and reports on files outside the commit.
REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
cd "$REPO" || exit 1

if [ "${MMGR_HOOK_NO_BANNED_SCAN:-0}" = "1" ]; then
    echo "pre-commit: banned-word scan bypassed by MMGR_HOOK_NO_BANNED_SCAN=1"
    exit 0
fi

GUARD_DIR=${MMGR_COMMIT_GUARD:-}
CHECKER=$GUARD_DIR/check_banned.py

if [ ! -f "$CHECKER" ]; then
    echo "pre-commit: BLOCKED - no banned-word checker at $CHECKER"
    echo "            Set MMGR_COMMIT_GUARD to the directory holding check_banned.py."
    echo "            Refusing rather than skipping: a gate that cannot find its checker and"
    echo "            exits 0 is indistinguishable from one that ran and passed."
    exit 1
fi

PYBIN=$(command -v python 2>/dev/null || command -v python3 2>/dev/null)
if [ -z "$PYBIN" ]; then
    echo "pre-commit: BLOCKED - no python on PATH to run $CHECKER"
    exit 1
fi

if ! "$PYBIN" "$CHECKER" "$REPO"; then
    echo "pre-commit: BLOCKED - the tree carries a banned word. The words are listed outside this"
    echo "            repository, in $GUARD_DIR. Fix the lines named above before committing."
    exit 1
fi

exit 0
