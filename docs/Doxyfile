#
# Run from the repository root:  doxygen docs/Doxyfile
#
# Only settings that were chosen are written here. Everything else takes its default, so this file
# reads as a list of decisions rather than the 400-odd tags `doxygen -g` emits. A setting that is
# here has a reason next to it.
#
# The docs workflow runs this file a second time with GENERATE_XML=YES appended from stdin, to feed
# the documented-symbol coverage generator. It does not keep a second config.

# -------------------------------------------------------------------------------------------------
# Identity
# -------------------------------------------------------------------------------------------------
PROJECT_NAME           = "MMgr"
PROJECT_BRIEF          = "Zero-heap memory manager in C11. One borrowed buffer, carved by asserted offset."
PROJECT_NUMBER         = "v1.1.0"
PROJECT_LOGO           = docs/assets/mark.svg
PROJECT_ICON           = docs/assets/favicon.ico
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO

# -------------------------------------------------------------------------------------------------
# Input
# -------------------------------------------------------------------------------------------------
# *.c is absent on purpose. Every public entity appears in a header, so bodies left out lose
# nothing documentable. Bodies left out are also what makes EXTRACT_STATIC safe below. With
# .c in, EXTRACT_STATIC would pull in every file-local helper in the library.
#
# The root README.md is also absent on purpose. It is the GitHub front door; docs/README.md is the
# site front door. Both in INPUT gives two pages called "README" that both want the main page.
#
# include/ carries mmgr.h, the header a consumer includes. It holds the pool declarations,
# the three name guards and the attribute wrappers. Left out, none of them reach the
# reference at all.
INPUT                  = include src docs CONTRIBUTING.md SECURITY.md CHANGELOG.md
FILE_PATTERNS          = *.h *.md *.dox
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/README.md
IMAGE_PATH             = docs/assets

# \snippet pulls worked examples straight out of the test suite. An example in the docs is a
# compiled test that passes rather than prose that drifts.
EXAMPLE_PATH           = .
EXAMPLE_RECURSIVE      = YES

# The exclusion of docs/html matters: without it a second run documents the first run's output.
EXCLUDE_PATTERNS       = */docs/html/* \
                         */docs/xml/* \
                         */build/* \
                         */build-*/* \
                         */node_modules/* \
                         */anchor_cost/anchor_cost_*.h

# The argument count and slot expansion steps. Nobody calls these; they are the parts of EMBED_NARG and
# EMBED_TABLE_LAYOUT, and a list of twenty-four of them one per arity buries the two
# macros that matter.
EXCLUDE_SYMBOLS        = EMBED_TABLE_SLOTS_[0-9]* \
                         EMBED_TABLE_SLOT \
                         EMBED_ARG_N \
                         EMBED_NARG_ \
                         EMBED_CAT_ \
                         EMBED_DIAGNOSTIC_STRING \
                         _STRING_H \
                         _STRING_H_ \
                         __STRING_H__ \
                         _STRING_H_INCLUDED \
                         _INC_STRING

# -------------------------------------------------------------------------------------------------
# Extraction
# -------------------------------------------------------------------------------------------------
# EXTRACT_ALL = NO, and it is not a style preference. Doxygen disables WARN_IF_UNDOCUMENTED whenever
# EXTRACT_ALL is YES, so YES does not weaken the coverage signal. It switches it off, and the run
# then reports a clean tree whatever the undocumented count. NO also keeps the site honest. An
# undocumented entity is absent rather than a bare signature that looks the same as a
# documented one.
EXTRACT_ALL            = NO

# Not optional for this library. EMBED_TABLE_STORAGE is `static const`, so the dispatch tables -
# spat, memor, lane and the rest, which ARE the call-site API - are file-scope statics. With NO they
# do not appear anywhere in the reference.
EXTRACT_STATIC         = YES

EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = NO
INTERNAL_DOCS          = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Every struct here is `typedef struct { ... } mmgr_spat;`. Without this each one documents twice:
# once as an anonymous struct and once as the typedef.
TYPEDEF_HIDES_STRUCT   = YES

# C, not C++. Drops the C++-only tabs and renames "Classes" to "Data Structures".
OPTIMIZE_OUTPUT_FOR_C  = YES

# src/ is the include root, so the include path a caller writes IS part of the contract. Print it.
SHOW_HEADERFILE        = YES
SHOW_INCLUDE_FILES     = YES

# -------------------------------------------------------------------------------------------------
# Ordering
# -------------------------------------------------------------------------------------------------
# Not cosmetic. EMBED_TABLE_LAYOUT asserts the byte offset of every dispatch slot, so the declaration
# order of an Ns struct is the table's layout. Members in name order would document slot 0
# of SpatiumNs as `after` when it is `from`.
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = NO

# The group tree in docs/groups.dox reads as the data path: region -> view -> scan ->
# serialize -> emit. Name order would scatter that.
SORT_GROUP_NAMES       = NO
DISTRIBUTE_GROUP_DOC   = NO
GROUP_NESTED_COMPOUNDS = NO

# -------------------------------------------------------------------------------------------------
# Preprocessor
# -------------------------------------------------------------------------------------------------
# The highest-risk block in this file. Without the blanks below, `EMBED_INLINE embed_word f(void)`
# parses as a function whose return type is EMBED_INLINE. Every inline entry in verbum_scrutor.h
# and proximus_operor.h then reports undocumented whatever comment sits above it.
#
# EMBED_TABLE_LAYOUT is a 24-way recursive macro that expands to a chain of static assertions. Its
# full expansion produces pages of noise per module.
#
# EMBED_CALL takes an entry, a config type and the initializers, so its blank has to be variadic. An
# arity that does not match leaves the macro unexpanded and every call site in the prose renders raw.
#
# The two ENABLE flags default to 0, which would document memoriam_praetereo.h and memoria_externa.h
# as empty files - their entire contents sit behind the gate. Set to 1 here so the gated API
# appears; the module guides say plainly that the gate is off by default.
#
# The width macros pin one branch of the ladders in embed_types.h so embed_word resolves to a single
# concrete type in the output. The page reference/environments.md carries the note that the
# reference comes from the 64-bit configuration. The other four environments differ only in these
# typedefs.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SKIP_FUNCTION_MACROS   = YES
PREDEFINED             = DOXYGEN \
                         EMBED_BEGIN_DECLS= \
                         EMBED_END_DECLS= \
                         EMBED_INLINE="static inline" \
                         EMBED_TABLE_STORAGE="static const" \
                         EMBED_UNUSED= \
                         EMBED_WEAK= \
                         EMBED_ALIAS= \
                         EMBED_RAW= \
                         "EMBED_ENUM_BYTE(name_,...)=typedef enum { __VA_ARGS__ } name_" \
                         EMBED_ALIGN(x)= \
                         EMBED_CALL(...)= \
                         EMBED_STATIC_ASSERT(c,m)= \
                         EMBED_TABLE_LAYOUT(...)= \
                         MMGR_ERROR_ATTR(m)= \
                         MMGR_ALLOC_SIZE(a)= \
                         MMGR_EXTRAM_ATTR= \
                         MMGR_ENABLE_DMA=1 \
                         MMGR_ENABLE_EXTRAM=1 \
                         MMGR_ENABLE_LOCK=1 \
                         MMGR_ENABLE_OWNERS=1 \
                         EMBED_WORD_BITS=64 \
                         EMBED_INDEX_BITS=32

# The Ns table initializers are seventeen blocks of `.member = mmgr_x_y,` about fifteen lines each,
# and the ASCII and anchor-cost tables are 256-entry arrays. The struct is the contract; the
# initializer is noise. The prose states the values that matter.
MAX_INITIALIZER_LINES  = 0

# -------------------------------------------------------------------------------------------------
# Markdown and links
# -------------------------------------------------------------------------------------------------
MARKDOWN_SUPPORT       = YES
# GITHUB gives a heading anchor the same form here and on github.com, and one link works in both.
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
ENUM_VALUES_PER_LINE   = 1

# Repo-specific commands. A comment can be terse and the output stays consistent.
ALIASES                = "ns{1}=@par Namespace^^`\1`" \
                         "position{1}=@par Dispatch position^^\1" \
                         "borrows=@par Borrows^^Does not allocate. Writes only into storage the caller supplied." \
                         "bounded{1}=@par Bounded^^Reads at most \1 bytes and stops." \
                         "widthdep=@par Width^^Behavior follows EMBED_WORD_BITS. See @ref ref_environments."

# -------------------------------------------------------------------------------------------------
# Source browser
# -------------------------------------------------------------------------------------------------
# STRIP_CODE_COMMENTS = NO because in this library the discursive prose in the comments
# IS the value of the source. Without it the reader gets the half they can already infer.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
VERBATIM_HEADERS       = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# -------------------------------------------------------------------------------------------------
# Warnings
# -------------------------------------------------------------------------------------------------
# src/ carries real Doxygen comments, so these have something to say. The log is a product of the
# docs job rather than a side effect. The job keeps it, summarizes it into the job summary, and
# ratchets it. A NEW undocumented symbol fails a pull request while the current backlog does not.
#
# WARN_AS_ERROR becomes FAIL_ON_WARNINGS_PRINT once the count reaches zero. Not YES: YES aborts at
# the first warning, so you fix one, re-run, and find the next. FAIL_ON_WARNINGS_PRINT completes the
# run, prints everything, then exits non-zero.
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = docs/doxygen-warnings.log

# -------------------------------------------------------------------------------------------------
# Output
# -------------------------------------------------------------------------------------------------
# The html/ and xml/ trees sit as siblings under docs/. So the Pages artifact uploads docs/html alone
# and the XML the coverage generator reads never goes public.
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_XML           = NO
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO

# The default template plus the IBM Plex <link> tags. Regenerate with
#   doxygen -w html docs/header.html /dev/null /dev/null
# on a doxygen upgrade, then re-add the font block - the rest of the file is doxygen's.
HTML_HEADER            = docs/header.html
HTML_FOOTER            = docs/footer.html
HTML_EXTRA_STYLESHEET  = docs/mmgr.css
HTML_EXTRA_FILES       = docs/assets/favicon.svg docs/assets/apple-touch-icon.png
LAYOUT_FILE            = docs/DoxygenLayout.xml

# TOGGLE gives the reader a light/dark switch. The HUE/SAT/GAMMA below only tint doxygen's own
# generated values, which docs/mmgr.css overrides. They matter for the pre-JS paint and for any
# variable the stylesheet fails to map. There 222/35/95 makes those look like a muted indigo miss
# rather than a doxygen-blue one.
HTML_COLORSTYLE        = TOGGLE
HTML_COLORSTYLE_HUE    = 222
HTML_COLORSTYLE_SAT    = 35
HTML_COLORSTYLE_GAMMA  = 95

HTML_DYNAMIC_MENUS     = YES
# Collapsed-by-default sections hide content from the reader and from Ctrl-F. A printed spec does
# not fold.
HTML_DYNAMIC_SECTIONS  = NO
HTML_COPY_CLIPBOARD    = YES
HTML_CODE_FOLDING      = YES
HTML_INDEX_NUM_ENTRIES = 100

# 300 rather than doxygen's 260. A long module name keeps its full text in the tree view.
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
TREEVIEW_WIDTH         = 300

SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# No graphviz dependency in the docs job, and a call graph of mmgr_scrut_has_zero is not
# information. The one graph worth the effort, which module depends on which, comes from
# docs/diagrams/module-deps.dot through standalone dot. The structural diagrams in docs/assets
# come from hand work.
HAVE_DOT               = NO

QUIET                  = NO
NUM_PROC_THREADS       = 0
